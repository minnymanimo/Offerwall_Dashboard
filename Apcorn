<script>
// 음수 KRW 값을 "-₩1,234"로 표기(부호가 화폐기호 뒤로 가는 걸 방지).
// 반올림해서 0이 되는 값은 "-₩0"이 되지 않도록 부호를 뗀다.
const _krwFmt = new Intl.NumberFormat('ko-KR', {maximumFractionDigits:0});
function fmtKrwPlain(v){
  const roundedAbs = Math.round(Math.abs(v));
  const sign = (v < 0 && roundedAbs !== 0) ? '-' : '';
  return sign + '₩' + _krwFmt.format(Math.abs(v));
}
function fmtKrw(v){ return v == null ? '–' : fmtKrwPlain(v); }

const ApcornSsp = (function(){


let DATA = null;
const f0 = new Intl.NumberFormat('ko-KR',{maximumFractionDigits:0});
const f2 = new Intl.NumberFormat('ko-KR',{maximumFractionDigits:2});
const METRICS = [
  {key:'impressions',label:'노출수',fmt:v=>v==null?'–':f0.format(v)},
  {key:'clicks',label:'클릭수',fmt:v=>v==null?'–':f0.format(v)},
  {key:'ctr',label:'CTR',fmt:v=>v==null?'–':f2.format(v*100)+'%'},
  {key:'cpc',label:'CPC',fmt:v=>fmtKrw(v)},
  {key:'revenue',label:'정산금액',fmt:v=>fmtKrw(v)},
  {key:'revenueChange',label:'변화율',fmt:v=>fmtChange(v),isChange:true},
  {key:'revShare',label:'매출비중',fmt:v=>v==null?'–':f2.format(v*100)+'%'},
  {key:'ecpm',label:'eCPM',fmt:v=>fmtKrw(v)},
  {key:'ecpmChange',label:'변화율',fmt:v=>fmtChange(v),isChange:true},
];
// 변화율 표기 — 미미한 변동(±3% 미만)은 회색으로 눌러서 시각적 노이즈를 줄인다.
// null은 비교할 직전 7일이 없는 경우(데이터 14일 미만).
function fmtChange(v){
  if (v == null) return '<span class="chg-na">–</span>';
  const cls = Math.abs(v) < 3 ? 'chg-flat' : (v > 0 ? 'chg-up' : 'chg-down');
  return `<span class="chg ${cls}">${v > 0 ? '+' : ''}${v.toFixed(1)}%</span>`;
}
// 팝업 그래프 대상 지표만 (매출비중은 현재 필터 안에서의 상대값이라 일별로 쪼개면
// 의미가 달라지므로 팝업 그래프 대상에서 제외. 변화율도 파생값이라 제외)
const CHARTABLE = ['impressions','clicks','ctr','cpc','revenue','ecpm'];
function getVar(n){ return getComputedStyle(document.documentElement).getPropertyValue(n).trim(); }

let sI=0, eI=0, activePreset='7';
let sortKey='revenue', sortDir='desc';
// 히트맵과 분포도는 서로 다른 용도로 쓰이므로 OS 필터를 각각 독립적으로 둔다.
let osHeat='all', osScatter='all';
// 지면 선택 필터는 반대로 히트맵·분포도 양쪽에 공유로 적용한다(사용자 요청).
// null = 전체 지면 표시, Set이면 그 안의 id만 표시.
let placementFilter = null;
// 이미 한 번이라도 목록에 나타났던 지면 id — 갱신 때 '새로 생긴 지면'을 구분하는 데 쓴다.
let knownPlacementIds = new Set();
let openId=null; // 지면명 클릭 시 펼쳐진 일자별 표의 대상 (한 번에 하나만)
let scatterChart=null, modalChart=null;
let modalState=null; // {placementId, metricKey, sI, eI}

function periodDates(rangeS, rangeE){ return DATA.dates.slice(rangeS,rangeE+1); }

// 선택 기간 + 주어진 OS 필터 + 공유 지면 필터 기준 지면별 집계
// (비율 지표는 합산 후 도출 — 일별 비율의 단순평균이 아님)
function aggregate(osFilter){
  let src = osFilter==='all' ? DATA.placements : DATA.placements.filter(p=>p.os===osFilter);
  if (placementFilter) src = src.filter(p => placementFilter.has(p.id));
  const rows = src.map(p=>{
    let imp=0,clk=0,rev=0,any=false;
    for(let i=sI;i<=eI;i++){
      if(p.impressions[i]!=null){imp+=p.impressions[i];clk+=p.clicks[i];rev+=p.revenue[i];any=true;}
    }
    return {id:p.id,name:p.name,os:p.os,
      impressions:any?imp:null, clicks:any?clk:null, revenue:any?rev:null,
      ctr:imp?clk/imp:null, cpc:clk?rev/clk:null, ecpm:imp?rev/imp*1000:null};
  });
  // 매출비중은 "현재 보이는 지면들" 안에서의 비중 — Android만 필터하면
  // Android 지면들끼리의 비중으로 다시 계산된다.
  const tot = rows.reduce((s,r)=>s+(r.revenue||0),0);
  rows.forEach(r=>{
    r.revShare = tot?( (r.revenue||0)/tot ):null;
    // 변화율은 선택 기간과 무관하게 항상 최근 14일 기준(위 computeChangeRates 참고)
    const p = DATA.placements.find(x => x.id === r.id);
    const ch = p ? computeChangeRates(p) : {revenueChange:null, ecpmChange:null};
    r.revenueChange = ch.revenueChange;
    r.ecpmChange = ch.ecpmChange;
  });
  return rows;
}

function applyPreset(p){
  activePreset=p;
  const n=DATA.dates.length;
  eI=n-1; sI=(p==='all') ? 0 : Math.max(0, n-parseInt(p,10));
  document.querySelectorAll('#ap-presetSeg button').forEach(b=>b.classList.toggle('active', b.dataset.p===p));
  const ds=periodDates(sI,eI);
  document.getElementById('ap-periodLabel').textContent = `기간: ${ds[0]} ~ ${ds[ds.length-1]} (${ds.length}일)`;
  document.getElementById('ap-startInput').value = DATA.dates[sI];
  document.getElementById('ap-endInput').value = DATA.dates[eI];
  openId=null; // 기간이 바뀌면 펼쳐둔 일자별 표의 내용도 달라지므로 접는다
  renderScatter(); renderHeat();
}

function onDateInputChange(){
  const dates = DATA.dates;
  const sVal = document.getElementById('ap-startInput').value;
  const eVal = document.getElementById('ap-endInput').value;
  let s = 0;
  if (sVal){ s = dates.findIndex(d => d >= sVal); if (s === -1) s = dates.length - 1; }
  let e = dates.length - 1;
  if (eVal){ e = -1; for (let i = dates.length-1;i>=0;i--){ if (dates[i] <= eVal){ e=i; break; } } if (e===-1) e=0; }
  if (s > e){ const t=s; s=e; e=t; }
  sI = s; eI = e; activePreset = null;
  document.querySelectorAll('#ap-presetSeg button').forEach(b=>b.classList.toggle('active', false));
  const ds=periodDates(sI,eI);
  document.getElementById('ap-periodLabel').textContent = `기간: ${ds[0]} ~ ${ds[ds.length-1]} (${ds.length}일)`;
  openId=null;
  renderScatter(); renderHeat();
}

function applyOsHeat(os){
  osHeat=os;
  document.querySelectorAll('#ap-osSegHeat button').forEach(b=>b.classList.toggle('active', b.dataset.os===os));
  // 필터를 바꾸면 펼쳐둔 지면이 목록에서 사라질 수 있으므로 접는다
  if(openId!=null){
    const still = aggregate(osHeat).some(r=>r.id===openId);
    if(!still) openId=null;
  }
  renderHeat();
}

function applyOsScatter(os){
  osScatter=os;
  document.querySelectorAll('#ap-osSegScatter button').forEach(b=>b.classList.toggle('active', b.dataset.os===os));
  renderScatter();
}

/* ---------- 지면 선택 필터 (히트맵 + 분포도 공유) ---------- */
function renderPlacementFilterList(){
  // 갱신 시 새로 생긴 지면은 사용자가 선택/해제한 적이 없으므로 기본적으로 '보이도록'
  // 필터에 추가한다. 그러지 않으면 새 지면이 조용히 숨겨져 매출을 놓칠 수 있다.
  if (placementFilter){
    DATA.placements.forEach(p => {
      if (!knownPlacementIds.has(p.id)) placementFilter.add(p.id);
    });
  }
  DATA.placements.forEach(p => knownPlacementIds.add(p.id));

  const box = document.getElementById('ap-placementFilterList');
  box.innerHTML = DATA.placements.map(p => {
    const checked = !placementFilter || placementFilter.has(p.id);
    const shortName = p.name.replace(/^티머니GO_/, '');
    return `<label class="placement-filter-item">
      <input type="checkbox" data-id="${p.id}" ${checked?'checked':''}>
      <span title="${p.name}">${shortName} (${p.os})</span>
    </label>`;
  }).join('');
  updatePlacementFilterCount();
}

function updatePlacementFilterCount(){
  const btn = document.getElementById('ap-placementFilterBtn');
  const countEl = document.getElementById('ap-placementFilterCount');
  if (!placementFilter || placementFilter.size === DATA.placements.length){
    countEl.textContent = '(전체)';
    btn.classList.remove('has-filter');
  } else {
    countEl.textContent = `(${placementFilter.size}/${DATA.placements.length})`;
    btn.classList.add('has-filter');
  }
}

function applyPlacementFilterChange(){
  const boxes = [...document.querySelectorAll('#ap-placementFilterList input[type="checkbox"]')];
  const checkedIds = boxes.filter(b=>b.checked).map(b=>b.dataset.id);
  placementFilter = (checkedIds.length === DATA.placements.length) ? null : new Set(checkedIds);
  updatePlacementFilterCount();
  if(openId!=null && placementFilter && !placementFilter.has(openId)) openId=null;
  renderScatter(); renderHeat();
}

document.getElementById('ap-placementFilterBtn').addEventListener('click', (e)=>{
  e.stopPropagation();
  document.getElementById('ap-placementFilterDropdown').classList.toggle('open');
});
document.getElementById('ap-placementFilterList').addEventListener('change', applyPlacementFilterChange);
document.getElementById('ap-placementSelectAll').addEventListener('click', ()=>{
  document.querySelectorAll('#ap-placementFilterList input').forEach(b=>b.checked=true);
  applyPlacementFilterChange();
});
document.getElementById('ap-placementSelectNone').addEventListener('click', ()=>{
  document.querySelectorAll('#ap-placementFilterList input').forEach(b=>b.checked=false);
  applyPlacementFilterChange();
});
document.addEventListener('click', (e)=>{
  const dd = document.getElementById('ap-placementFilterDropdown');
  const btn = document.getElementById('ap-placementFilterBtn');
  if (dd.classList.contains('open') && !dd.contains(e.target) && e.target!==btn) dd.classList.remove('open');
});

function ensureScatterCanvas(){
  const el = document.getElementById('ap-scatterCanvas');
  if (el && el.tagName !== 'CANVAS'){
    el.outerHTML = '<canvas id="ap-scatterCanvas"></canvas>';
  }
}

function renderScatter(){
  // 데이터 없음/오류로 이전에 캔버스 자리가 <div>로 바뀌어 있을 수 있으므로,
  // 그릴 데이터가 있을 가능성에 대비해 항상 먼저 진짜 <canvas>로 되돌려놓는다.
  ensureScatterCanvas();
  const all=aggregate(osScatter);
  // 로그 축은 0 이하를 표현할 수 없어 Chart.js가 해당 점을 조용히 빼버린다.
  // 사용자가 모르게 지면이 사라지지 않도록 직접 걸러내고 몇 개가 빠졌는지 표시한다.
  const rows=all.filter(r=>r.impressions!=null && r.impressions>0 && r.ecpm!=null);
  const excluded=all.length-rows.length;
  const note=document.getElementById('ap-scatterNote');
  if(note){
    note.textContent = excluded
      ? `이 기간에 노출이 없는 ${excluded}개 지면은 분포도에서 제외됐습니다 (히트맵에는 그대로 표시됩니다).`
      : '';
  }
  if(!rows.length){
    const box=document.querySelector('#ap-scatterCanvas');
    if(box) box.outerHTML='<div id="ap-scatterCanvas" style="text-align:center;padding:40px;color:var(--text-dim);font-size:13px;">이 기간·필터에 표시할 지면이 없습니다.</div>';
    return;
  }
  const totRev=rows.reduce((s,r)=>s+(r.revenue||0),0);
  const impVals=rows.map(r=>r.impressions).sort((a,b)=>a-b);
  const ecpmVals=rows.map(r=>r.ecpm).sort((a,b)=>a-b);
  const medImp=impVals[Math.floor(impVals.length/2)]||0;
  const medEcpm=ecpmVals[Math.floor(ecpmVals.length/2)]||0;

  const points=rows.map(r=>({x:r.impressions,y:r.ecpm,
    r:Math.max(4,Math.sqrt(Math.max(0,(r.revenue/totRev)||0)*100)*4), _p:r, _share:(r.revenue/totRev)||0}));
  const colors=points.map(pt=>{
    const hiVol=pt.x>=medImp, hiEff=pt.y>=medEcpm;
    if(hiVol&&hiEff)return '#5ee6a4'; if(hiVol&&!hiEff)return '#f6b860';
    if(!hiVol&&hiEff)return '#60a5fa'; return '#6b6980';
  });

  if(scatterChart){scatterChart.destroy();scatterChart=null;}
  const canvasEl=document.getElementById('ap-scatterCanvas');
  if(!canvasEl) return;
  try{
    const ctx=canvasEl.getContext('2d');
    scatterChart=new Chart(ctx,{type:'bubble',
      data:{datasets:[{data:points,backgroundColor:colors.map(c=>c+'cc'),borderColor:colors,borderWidth:1}]},
      options:{responsive:true,maintainAspectRatio:false,
        plugins:{legend:{display:false},
          tooltip:{backgroundColor:'#1e1e2c',borderColor:'#33334a',borderWidth:1,padding:10,
            titleFont:{family:"'Malgun Gothic',sans-serif",size:11.5},bodyFont:{family:"'JetBrains Mono',monospace",size:11},
            callbacks:{title:it=>it[0].raw._p.name,
              label:it=>{const p=it.raw._p;return['노출수: '+f0.format(p.impressions),'eCPM: \u20a9'+f0.format(p.ecpm),
                '매출: \u20a9'+f0.format(p.revenue)+' ('+f2.format(it.raw._share*100)+'%)'];}}}},
        scales:{x:{type:'logarithmic',title:{display:true,text:'노출수 (로그 축)',color:'#54526a',font:{size:10.5}},
            grid:{color:'#20202c'},ticks:{color:'#54526a',font:{family:"'JetBrains Mono',monospace",size:9},
              callback:v=>Math.abs(v)>=1000?Math.round(v/1000)+'k':v},border:{color:'#282836'}},
          y:{title:{display:true,text:'eCPM (원)',color:'#54526a',font:{size:10.5}},grid:{color:'#20202c'},
            ticks:{color:'#54526a',font:{family:"'JetBrains Mono',monospace",size:9}},border:{display:false}}}}
    });
  }catch(err){
    canvasEl.outerHTML='<div id="ap-scatterCanvas" style="text-align:center;padding:24px;color:var(--down);font-size:13px;">차트 오류: '+err.message+'</div>';
    scatterChart=null;
    console.error('scatter failed:',err);
  }
}

// 정산금액·eCPM의 "최근 7일 vs 직전 7일" 변화율(%)을 지면별로 계산.
// 7일씩 묶어서 비교하므로 하루짜리 노이즈에 흔들리지 않는다.
// eCPM은 비율 지표라 각 7일 블록의 합계로 다시 계산해서 비교한다
// (일별 eCPM 7개를 단순평균하면 노출량이 적은 날이 과대 반영되어 틀린 값이 나온다).
// 데이터가 14일 미만이라 직전 7일을 확보할 수 없으면 null을 반환해 '–'로 표시된다.
const CHANGE_WINDOW = 7;
function computeChangeRates(placement){
  const need = CHANGE_WINDOW * 2;
  // 선택한 기간과 무관하게, 항상 데이터 전체의 마지막 14일을 기준으로 계산한다
  // (기간 버튼을 바꿔도 변화율이 뒤집히지 않도록).
  const n = DATA.dates.length;
  if (n < need) return {revenueChange: null, ecpmChange: null};

  function blockSums(fromIdx, toIdx){
    let imp = 0, rev = 0, any = false;
    for (let i = fromIdx; i <= toIdx; i++){
      if (placement.revenue[i] == null || placement.impressions[i] == null) continue;
      imp += placement.impressions[i];
      rev += placement.revenue[i];
      any = true;
    }
    return any ? {imp, rev} : null;
  }
  const recent = blockSums(n - CHANGE_WINDOW, n - 1);
  const prev = blockSums(n - need, n - CHANGE_WINDOW - 1);
  if (!recent || !prev) return {revenueChange: null, ecpmChange: null};

  const revChange = prev.rev ? ((recent.rev / prev.rev) - 1) * 100 : null;
  const recentEcpm = recent.imp ? recent.rev / recent.imp * 1000 : null;
  const prevEcpm = prev.imp ? prev.rev / prev.imp * 1000 : null;
  const ecpmChange = (recentEcpm != null && prevEcpm) ? ((recentEcpm / prevEcpm) - 1) * 100 : null;
  return {revenueChange: revChange, ecpmChange: ecpmChange};
}

function renderHeat(){
  const rows=aggregate(osHeat);
  const pctByKey={};
  METRICS.filter(m=>m.key!=='name').forEach(m=>{
    const vals=rows.map(r=>r[m.key]).filter(v=>v!=null).sort((a,b)=>a-b);
    const map=new Map();
    rows.forEach(r=>{
      const v=r[m.key];
      if(v==null){map.set(r.id,null);return;}
      map.set(r.id, vals.length>1 ? (vals.indexOf(v)/(vals.length-1))*100 : 100);
    });
    pctByKey[m.key]=map;
  });

  const sortMeta = METRICS.find(m => m.key === sortKey);
  const sortIsChange = !!(sortMeta && sortMeta.isChange);
  const sorted=[...rows].sort((a,b)=>{
    const av=a[sortKey], bv=b[sortKey];
    // 변화율 열은 '가장 크게 움직인 순'이 목적이라 부호를 무시하고 절댓값으로 정렬한다.
    // 비교할 직전 7일이 없어 null인 지면은 정렬 방향과 무관하게 항상 맨 아래로 보낸다.
    if (sortIsChange){
      if (av == null && bv == null) return 0;
      if (av == null) return 1;
      if (bv == null) return -1;
      return sortDir==='desc' ? Math.abs(bv)-Math.abs(av) : Math.abs(av)-Math.abs(bv);
    }
    return sortDir==='desc'?(bv||0)-(av||0):(av||0)-(bv||0);
  });

  if(!sorted.length){
    document.getElementById('ap-heatTable').innerHTML =
      '<tbody><tr><td style="padding:16px;color:var(--text-dim);">이 필터에 해당하는 지면이 없습니다.</td></tr></tbody>';
    return;
  }

  let h='<thead><tr><th>지면명</th>'+METRICS.map(m=>{
    const arrow=sortKey===m.key?(sortDir==='desc'?' ▼':' ▲'):'';
    return `<th data-k="${m.key}" class="${sortKey===m.key?'sorted':''}">${m.label}${arrow}</th>`;
  }).join('')+'</tr></thead><tbody>';

  sorted.forEach(r=>{
    const isOpen = openId===r.id;
    h+=`<tr><td class="name-cell${isOpen?' open':''}" data-id="${r.id}"><span class="arrow">▶</span>${r.name}<span style="color:var(--text-faint);font-size:10px">(${r.os})</span></td>`;
    METRICS.filter(m=>m.key!=='name').forEach(m=>{
      const v=r[m.key];
      // 변화율 열은 히트맵 색을 입히지 않는다 — 색은 '지면 간 절대값 순위'를 뜻하는데
      // 변화율은 성격이 달라서 같은 색 규칙을 쓰면 오해를 부른다. 색 대신 자체 색상(초록/빨강)만 사용.
      if (m.isChange){ h+=`<td class="chg-cell">${m.fmt(v)}</td>`; return; }
      const pct=pctByKey[m.key].get(r.id);
      const clickable = CHARTABLE.includes(m.key) && v!=null;
      const cls = clickable ? ' class="clickable"' : '';
      const attrs = clickable ? ` data-id="${r.id}" data-metric="${m.key}"` : '';
      if(pct==null){h+=`<td${cls}${attrs}>${m.fmt(v)}</td>`;return;}
      const t=pct/100, cr=Math.round(27+69*t), cg=Math.round(27+138*t), cb=Math.round(40+210*t);
      const fg=pct>=55?'#0b1420':'#c7c5d6';
      h+=`<td${cls}${attrs} style="background:rgb(${cr},${cg},${cb});color:${fg}">${m.fmt(v)}</td>`;
    });
    h+='</tr>';
    if(isOpen) h+=renderDrillRow(r.id);
  });
  h+='</tbody>';
  document.getElementById('ap-heatTable').innerHTML=h;

  document.querySelectorAll('#ap-heatTable th[data-k]').forEach(th=>{
    th.addEventListener('click',()=>{
      const k=th.dataset.k;
      if(sortKey===k)sortDir=sortDir==='desc'?'asc':'desc'; else{sortKey=k;sortDir='desc';}
      renderHeat();
    });
  });
  document.querySelectorAll('#ap-heatTable td.clickable').forEach(td=>{
    td.addEventListener('click',()=>{
      openModal(td.dataset.id, td.dataset.metric);
    });
  });
  document.querySelectorAll('#ap-heatTable td.name-cell').forEach(td=>{
    td.addEventListener('click',()=>{
      const id=td.dataset.id;
      openId = openId===id ? null : id;  // 같은 지면 다시 누르면 접기
      renderHeat();
    });
  });
}

// 지면명 클릭 시 그 아래로 펼쳐지는 일자별 표 (현재 선택된 기간 기준)
function renderDrillRow(id){
  const p=DATA.placements.find(x=>x.id===id);
  if(!p) return '';
  const ds=periodDates(sI,eI);
  let rowsHtml='';
  for(let i=sI;i<=eI;i++){
    const imp=p.impressions[i], clk=p.clicks[i], rev=p.revenue[i];
    const ctr=imp?clk/imp:null, cpc=clk?rev/clk:null, ecpm=imp?rev/imp*1000:null;
    rowsHtml+=`<tr><td>${DATA.dates[i]}</td>
      <td>${imp==null?'<span class="na">–</span>':f0.format(imp)}</td>
      <td>${clk==null?'<span class="na">–</span>':f0.format(clk)}</td>
      <td>${ctr==null?'<span class="na">–</span>':f2.format(ctr*100)+'%'}</td>
      <td>${cpc==null?'<span class="na">–</span>':fmtKrwPlain(cpc)}</td>
      <td>${rev==null?'<span class="na">–</span>':fmtKrwPlain(rev)}</td>
      <td>${ecpm==null?'<span class="na">–</span>':fmtKrwPlain(ecpm)}</td></tr>`;
  }
  // colspan은 지면명 1칸 + 지표 칸 수와 정확히 맞춰야 표가 어긋나지 않는다
  const colCount = 1 + METRICS.filter(m=>m.key!=='name').length;
  return `<tr class="drill-row"><td colspan="${colCount}"><div class="drill-box">
    <div class="drill-title">${p.name} · 일자별 수치 (${ds[0]} ~ ${ds[ds.length-1]})</div>
    <table class="daily"><thead><tr><th>날짜</th><th>노출수</th><th>클릭수</th><th>CTR</th><th>CPC</th><th>정산금액</th><th>eCPM</th></tr></thead>
    <tbody>${rowsHtml}</tbody></table>
  </div></td></tr>`;
}

/* ---------- 팝업: 지표 하나 클릭 시에만 해당 데이터로 그래프를 만든다 (지연 렌더링) ---------- */
// 팝업 기본 기간 = 항상 최근 14일. 변화율이 '이번주 7일 vs 전주 7일'(=최근 14일) 비교라서,
// 팝업을 열었을 때 그 비교의 근거가 된 기간을 그대로 보여주는 편이 자연스럽다.
// 메인 화면에서 현재 어떤 기간 버튼을 눌러뒀는지와는 무관하게 항상 이 기본값을 쓴다.
const MODAL_DEFAULT_PRESET = '14';
function defaultModalRange(){
  const n = DATA.dates.length;
  const e = n - 1;
  const s = Math.max(0, n - parseInt(MODAL_DEFAULT_PRESET, 10));
  return [s, e];
}

function openModal(placementId, metricKey){
  const p = DATA.placements.find(x=>x.id===placementId);
  if(!p) return;
  const [defS, defE] = defaultModalRange();
  modalState = {placementId, metricKey, sI: defS, eI: defE};
  const m = METRICS.find(x=>x.key===metricKey);
  document.getElementById('ap-modalTitle').textContent = `${p.name} · ${m.label}`;
  document.getElementById('ap-modalSub').textContent = `(${p.os})`;
  document.querySelectorAll('#ap-modalPresetSeg button').forEach(b=>
    b.classList.toggle('active', b.dataset.p===MODAL_DEFAULT_PRESET));
  syncModalInputs();
  document.getElementById('ap-modalBackdrop').classList.add('open');
  renderModalChart();
}

function syncModalInputs(){
  document.getElementById('ap-modalStartInput').value = DATA.dates[modalState.sI];
  document.getElementById('ap-modalEndInput').value = DATA.dates[modalState.eI];
}

function onModalDateInputChange(){
  if(!modalState) return;
  const dates = DATA.dates;
  const sVal = document.getElementById('ap-modalStartInput').value;
  const eVal = document.getElementById('ap-modalEndInput').value;
  let s = 0;
  if (sVal){ s = dates.findIndex(d => d >= sVal); if (s === -1) s = dates.length - 1; }
  let e = dates.length - 1;
  if (eVal){ e = -1; for (let i = dates.length-1;i>=0;i--){ if (dates[i] <= eVal){ e=i; break; } } if (e===-1) e=0; }
  if (s > e){ const t=s; s=e; e=t; }
  modalState.sI = s; modalState.eI = e;
  document.querySelectorAll('#ap-modalPresetSeg button').forEach(b=>b.classList.toggle('active', false));
  renderModalChart();
}

function closeModal(){
  document.getElementById('ap-modalBackdrop').classList.remove('open');
  if(modalChart){ modalChart.destroy(); modalChart=null; }
  modalState=null;
}

function modalSeries(){
  const p = DATA.placements.find(x=>x.id===modalState.placementId);
  const {sI:ms, eI:me} = modalState;
  const dates = periodDates(ms,me);
  const imp = p.impressions.slice(ms,me+1), clk = p.clicks.slice(ms,me+1), rev = p.revenue.slice(ms,me+1);
  let values;
  if(modalState.metricKey==='impressions') values = imp;
  else if(modalState.metricKey==='clicks') values = clk;
  else if(modalState.metricKey==='revenue') values = rev;
  else if(modalState.metricKey==='ctr') values = imp.map((v,i)=> v?clk[i]/v:null);
  else if(modalState.metricKey==='cpc') values = clk.map((v,i)=> v?rev[i]/v:null);
  else values = imp.map((v,i)=> v?rev[i]/v*1000:null); // ecpm
  return {dates, values};
}

function renderModalChart(){
  const {dates, values} = modalSeries();
  const m = METRICS.find(x=>x.key===modalState.metricKey);
  const color = getVar('--c-metric');

  if(modalChart){ modalChart.destroy(); modalChart=null; }
  const box = document.getElementById('ap-modalChartBox');
  if(!document.getElementById('ap-modalCanvas')){
    box.innerHTML = '<canvas id="ap-modalCanvas"></canvas>';
  }
  try{
    const ctx = document.getElementById('ap-modalCanvas').getContext('2d');
    const gradient = ctx.createLinearGradient(0,0,0,260);
    gradient.addColorStop(0, color+'33'); gradient.addColorStop(1, color+'00');
    const useBar = values.length<=3;
    modalChart = new Chart(ctx,{type: useBar?'bar':'line',
      data:{labels:dates.map(d=>d.slice(5).replace('-','/')),
        datasets:[{data:values, borderColor:color, backgroundColor: useBar?color:gradient,
          fill: !useBar, spanGaps:false, tension:.3, borderWidth:2,
          pointRadius: values.length<=20?3:0, pointHoverRadius:5, borderRadius:4, maxBarThickness:56}]},
      options:{responsive:true, maintainAspectRatio:false,
        interaction:{mode:'index', intersect:false},
        plugins:{legend:{display:false},
          tooltip:{backgroundColor:'#1e1e2c',borderColor:'#33334a',borderWidth:1,padding:9,
            titleFont:{family:"'JetBrains Mono',monospace",size:10.5},bodyFont:{family:"'JetBrains Mono',monospace",size:10.5},
            callbacks:{label:it=> it.parsed.y==null?'데이터 없음': m.fmt(it.parsed.y)}}},
        scales:{x:{grid:{display:false},border:{color:'#282836'},
            ticks:{color:'#54526a',font:{family:"'JetBrains Mono',monospace",size:9},maxRotation:0}},
          y:{grid:{color:'#20202c'},border:{display:false},
            ticks:{color:'#54526a',font:{family:"'JetBrains Mono',monospace",size:9},
              callback:v=> modalState.metricKey==='ctr' ? (v*100).toFixed(1)+'%' : (Math.abs(v)>=10000?Math.round(v/10000)+'만':f0.format(v))}}}}
    });
  }catch(err){
    box.innerHTML = `<div style="text-align:center;padding:24px;color:var(--down);font-size:13px;">차트 오류: ${err.message}</div>`;
    modalChart=null;
    console.error('modal chart failed:',err);
  }
}

document.getElementById('ap-presetSeg').addEventListener('click',e=>{
  const b=e.target.closest('button'); if(!b)return; applyPreset(b.dataset.p);
});
document.getElementById('ap-osSegHeat').addEventListener('click',e=>{
  const b=e.target.closest('button'); if(!b)return; applyOsHeat(b.dataset.os);
});
document.getElementById('ap-osSegScatter').addEventListener('click',e=>{
  const b=e.target.closest('button'); if(!b)return; applyOsScatter(b.dataset.os);
});
document.getElementById('ap-startInput').addEventListener('change', onDateInputChange);
document.getElementById('ap-endInput').addEventListener('change', onDateInputChange);
document.getElementById('ap-modalPresetSeg').addEventListener('click',e=>{
  const b=e.target.closest('button'); if(!b||!modalState)return;
  document.querySelectorAll('#ap-modalPresetSeg button').forEach(x=>x.classList.toggle('active',x===b));
  const n=DATA.dates.length, p=b.dataset.p;
  modalState.eI=n-1; modalState.sI=(p==='all') ? 0 : Math.max(0, n-parseInt(p,10));
  syncModalInputs();
  renderModalChart();
});
document.getElementById('ap-modalStartInput').addEventListener('change', onModalDateInputChange);
document.getElementById('ap-modalEndInput').addEventListener('change', onModalDateInputChange);
document.getElementById('ap-modalClose').addEventListener('click', closeModal);
document.getElementById('ap-modalBackdrop').addEventListener('click', e=>{
  if(e.target.id==='modalBackdrop') closeModal();
});
document.addEventListener('keydown', e=>{ if(e.key==='Escape' && modalState) closeModal(); });

function updateUnmappedBanner(payload){
  const el = document.getElementById('ap-unmappedBanner');
  const ids = payload.unmappedIds || [];
  if (!ids.length){ el.style.display='none'; return; }
  el.style.display = '';
  const shown = ids.slice(0, 5).join(', ');
  const more = ids.length > 5 ? ` 외 ${ids.length - 5}개` : '';
  el.innerHTML = `<b>매핑되지 않은 지면 ${ids.length}개</b> — 아래 목록에 <span class="unmapped-name">(미등록)</span>으로 표시됩니다. `
    + `구글시트의 <b>APCORN_SSP_ID</b> 탭에 지면명·OS를 추가해주세요.<br/>`
    + `<span class="unmapped-ids">${shown}${more}</span>`;
}

function initPage(payload){
  DATA = payload;
  updateUnmappedBanner(payload);
  if (!payload.dates || !payload.dates.length){
    document.getElementById('ap-heatTable').innerHTML =
      '<tbody><tr><td style="padding:16px;color:var(--text-dim);">표시할 데이터가 없습니다.</td></tr></tbody>';
    const sc = document.getElementById('ap-scatterCanvas');
    if (sc) sc.outerHTML = '<div id="ap-scatterCanvas" style="text-align:center;padding:40px;color:var(--text-dim);font-size:13px;">표시할 데이터가 없습니다.</div>';
    return;
  }
  const sIn = document.getElementById('ap-startInput'), eIn = document.getElementById('ap-endInput');
  sIn.min = payload.dates[0]; sIn.max = payload.dates[payload.dates.length-1];
  eIn.min = payload.dates[0]; eIn.max = payload.dates[payload.dates.length-1];
  const msIn = document.getElementById('ap-modalStartInput'), meIn = document.getElementById('ap-modalEndInput');
  msIn.min = payload.dates[0]; msIn.max = payload.dates[payload.dates.length-1];
  meIn.min = payload.dates[0]; meIn.max = payload.dates[payload.dates.length-1];
  renderPlacementFilterList();
  openId=null;
  if (modalState) closeModal();
  const fxWarn = document.getElementById('ap-fxWarn');
  if (fxWarn) fxWarn.style.display = payload.fxAvailable ? 'none' : '';
  applyPreset(activePreset || '7');
}
  return { init: initPage, reinit: initPage };
})();

function loadData(){
  return fetch('./apcorn-ssp.json?t=' + Date.now(), {cache:'no-store'}).then(res => {
    if (!res.ok) throw new Error('apcorn-ssp.json 요청 실패: HTTP ' + res.status);
    return res.json();
  });
}

function applyShared(payload){
  if (payload && payload.dates && payload.dates.length){
    document.getElementById('ap-dateRange').textContent =
      payload.dates[0].replace(/-/g,'.') + ' – ' + payload.dates[payload.dates.length-1].replace(/-/g,'.');
  }
  document.getElementById('ap-generatedAt').textContent = (payload && payload.generatedAt) || '–';
}

loadData().then(p => { applyShared(p); ApcornSsp.init(p); })
  .catch(err => {
    document.getElementById('ap-generatedAt').textContent = '로드 실패';
    console.error('initial load failed:', err);
  });

const REFRESH_MINUTES = 15;
let refreshing = false;
function refreshData(){
  if (refreshing) return;
  refreshing = true;
  const ind = document.getElementById('ap-refreshIndicator');
  ind.textContent = '갱신 중…';
  loadData().then(p => { applyShared(p); ApcornSsp.reinit(p); ind.textContent=''; refreshing=false; })
    .catch(() => { ind.textContent='갱신 실패'; refreshing=false; });
}
setInterval(refreshData, REFRESH_MINUTES * 60 * 1000);
document.getElementById('ap-refreshBtn').addEventListener('click', refreshData);
</script>
