<!DOCTYPE html>
<html lang="ko">
<head>
<base target="_top">
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<script src="./vendor/chart.umd.min.js"></script>
<style>


  :root{
    --bg:#0b0b11;
    --surface:#15151f;
    --surface-2:#1b1b28;
    --border:#282836;
    --text:#eceaf4;
    --text-dim:#918fa3;
    --text-faint:#54526a;
    --accent:#8b6fff;
    --accent-soft:rgba(139,111,255,0.14);
    --c-metric:#60a5fa;
    --up:#5ee6a4;
    --down:#f6789e;
    --mono:'JetBrains Mono','SF Mono',Consolas,'Courier New',monospace;
    --sans:'Malgun Gothic','Apple SD Gothic Neo','Noto Sans KR',sans-serif;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:
      radial-gradient(ellipse 900px 500px at 15% -10%, rgba(139,111,255,0.10), transparent 60%),
      var(--bg);
    color:var(--text);
    font-family:var(--sans);
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:1180px;margin:0 auto;padding:40px 24px 64px;}

  .pagenav{display:flex;gap:6px;margin-bottom:20px;}
  .pagenav a{
    font-family:var(--mono);font-size:11.5px;color:var(--text-dim);text-decoration:none;
    background:var(--surface);border:1px solid var(--border);border-radius:8px;
    padding:7px 14px;transition:border-color .12s ease, color .12s ease;
  }
  .pagenav a:hover{color:var(--text);border-color:var(--accent);}
  .pagenav a.active{color:var(--accent);border-color:var(--accent);background:var(--accent-soft);font-weight:700;}

  header{
    display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:16px;
    padding-bottom:22px;margin-bottom:24px;border-bottom:1px solid var(--border);
  }
  .eyebrow{
    font-family:var(--mono);font-size:11px;letter-spacing:0.16em;color:var(--accent);
    text-transform:uppercase;margin-bottom:10px;
  }
  h1{font-size:24px;font-weight:700;margin:0 0 6px;letter-spacing:-0.01em;}
  .subtitle{font-size:13px;color:var(--text-dim);}
  .subtitle b{color:var(--text);font-weight:600;}
  .meta-box{font-family:var(--mono);font-size:11.5px;color:var(--text-dim);text-align:right;line-height:1.7;}
  .meta-box .pill{
    display:inline-block;padding:2px 8px;border-radius:20px;
    background:var(--accent-soft);color:var(--accent);font-size:10.5px;margin-left:6px;
  }
  .refresh-row{display:flex;align-items:center;justify-content:flex-end;gap:8px;margin-top:4px;}
  #refreshIndicator{font-size:10.5px;color:var(--accent);min-width:70px;text-align:right;}
  #refreshBtn{
    font-family:var(--mono);font-size:10.5px;color:var(--text-dim);
    background:var(--surface);border:1px solid var(--border);border-radius:6px;
    padding:3px 9px;cursor:pointer;
  }
  #refreshBtn:hover{color:var(--text);border-color:var(--accent);}

  .controls-row{
    display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:14px;
    margin-bottom:22px;
  }
  .controls{display:flex;align-items:center;gap:14px;flex-wrap:wrap;}
  .seg{display:flex;background:var(--surface-2);border:1px solid var(--border);border-radius:8px;overflow:hidden;}
  .seg button{
    font-family:var(--mono);font-size:11px;color:var(--text-dim);
    background:transparent;border:0;padding:6px 12px;cursor:pointer;border-right:1px solid var(--border);
  }
  .seg button:last-child{border-right:0;}
  .seg button:hover{color:var(--text);}
  .seg button.active{background:var(--accent-soft);color:var(--accent);font-weight:700;}
  .seg button:focus-visible{outline:2px solid var(--accent);outline-offset:-2px;}
  .date-range{display:flex;align-items:center;gap:6px;}
  .date-range input[type="date"]{
    font-family:var(--mono);font-size:11px;color:var(--text);
    background:var(--surface-2);border:1px solid var(--border);border-radius:7px;
    padding:5px 8px;color-scheme:dark;cursor:pointer;
  }
  .date-range input:focus-visible{outline:2px solid var(--accent);outline-offset:-1px;}
  .date-range span{font-family:var(--mono);font-size:11px;color:var(--text-faint);}
  .period-label{font-family:var(--mono);font-size:10.5px;color:var(--text-faint);}

  .kpi-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;margin-bottom:28px;}
  .kpi-card{
    background:var(--surface);border:1px solid var(--border);border-radius:14px;
    padding:16px;position:relative;overflow:hidden;
  }
  .kpi-card::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--c-metric);}
  .kpi-label{font-size:11.5px;color:var(--text-dim);font-weight:600;margin-bottom:10px;}
  .kpi-value{font-family:var(--mono);font-size:18px;font-weight:700;letter-spacing:-0.02em;}
  .kpi-unit{font-size:10px;color:var(--text-faint);margin-top:3px;}

  .chart-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:28px;}
  .chart-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:16px 16px 8px;}
  .chart-title{font-size:12.5px;font-weight:700;margin-bottom:8px;}
  .chart-box{height:150px;position:relative;}
  #mwa-chartGrid .chart-box{height:128px;}

  .table-card{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:22px;overflow-x:auto;}
  .table-title{font-size:15px;font-weight:700;margin-bottom:16px;}
  table.datatable{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:13px;white-space:nowrap;}
  table.datatable th, table.datatable td{padding:11px 14px;text-align:right;border-bottom:1px solid var(--border);}
  table.datatable th:first-child, table.datatable td:first-child{text-align:left;font-weight:600;}
  table.datatable th{color:var(--text-dim);font-weight:700;font-size:11.5px;letter-spacing:.02em;
    position:sticky;top:0;background:var(--surface);padding-bottom:13px;border-bottom:2px solid var(--border);
    cursor:pointer;user-select:none;}
  table.datatable th:hover{color:var(--text);}
  table.datatable th.sorted{color:var(--accent);}
  table.datatable tbody tr:nth-child(even){background:rgba(255,255,255,0.015);}
  table.datatable tbody tr:hover{background:var(--accent-soft);}
  table.datatable tbody tr.latest-row td{color:var(--text);font-weight:700;}
  table.datatable tbody tr.latest-row{background:rgba(139,111,255,0.06);}
  table.datatable .latest-tag{font-size:10px;font-weight:400;color:var(--accent);}
  table.datatable td.na{color:var(--text-faint);}
  .kpi-delta{font-family:var(--mono);font-size:11px;margin-top:8px;display:flex;align-items:center;gap:5px;color:var(--text-dim);}
  .kpi-delta .arrow-up{color:var(--up);}
  .kpi-delta .arrow-down{color:var(--down);}

  .chart-error-box{
    text-align:center;padding:24px;color:var(--down);font-size:13px;line-height:1.6;
    background:var(--surface-2);border:1px dashed rgba(246,120,158,0.35);border-radius:10px;
  }

  @media (max-width:960px){
    .kpi-grid{grid-template-columns:repeat(3,1fr);}
    .chart-grid{grid-template-columns:1fr 1fr;}
  }
  @media (max-width:640px){
    .wrap{padding:28px 16px 48px;}
    .kpi-grid{grid-template-columns:1fr 1fr;}
    .chart-grid{grid-template-columns:1fr;}
    header{align-items:flex-start;}
    .meta-box{text-align:left;}
    .refresh-row{justify-content:flex-start;}
  }


  /* ---- Mobwith B 전용 ---- */

