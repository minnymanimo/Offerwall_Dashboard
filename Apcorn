  table.heat{width:100%;border-collapse:separate;border-spacing:2px;font-family:var(--mono);font-size:11.5px;}
  table.heat th,table.heat td{padding:8px 10px;text-align:center;}
  table.heat th{color:var(--text-dim);font-weight:600;font-size:10.5px;cursor:pointer;white-space:nowrap;}
  table.heat th:hover{color:var(--text);}
  table.heat th.sorted{color:var(--accent);}
  table.heat th:first-child,table.heat td.name-cell{text-align:left;white-space:normal;}
  table.heat td{border-radius:4px;}
  .name-cell{font-family:var(--sans) !important;font-size:12px;color:var(--text);cursor:pointer;
    display:flex;align-items:center;gap:6px;background:transparent !important;}
  .name-cell .arrow{font-size:9px;color:var(--text-faint);transition:transform .12s ease;}
  .name-cell.open .arrow{transform:rotate(90deg);color:var(--accent);}
